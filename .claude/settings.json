{
  "_comment": "Managed by harnais-deploy — engagement + enforcement (Couches 1 & 3). Edit via `harnais-deploy init --force`.",
  "hooks": {
    "PostToolUse": [
      {
        "_harnais_kallos": "consumer-wire-v1",
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/kallos_consumer_hook.sh\" posttool",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "_harnais_engagement": "engagement-merge-v1",
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/engagement_consumer_hook.sh\" session-down",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "_harnais_engagement": "engagement-merge-v1",
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/engagement_consumer_hook.sh\" session-up",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "_harnais_engagement": "engagement-merge-v1",
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/engagement_consumer_hook.sh\" stop-gate",
            "type": "command"
          }
        ]
      },
      {
        "_harnais_kallos": "consumer-wire-v1",
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/kallos_consumer_hook.sh\" stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
